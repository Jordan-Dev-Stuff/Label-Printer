#!/bin/sh
# Apply the USB permission rule right away, so a printer that is already
# plugged in works without unplugging it or rebooting.
set -e

if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usbmisc --action=change || true
fi

#DEBHELPER#
