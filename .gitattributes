# Normalise text to LF in the repository.
* text=auto

# Shell scripts run on Linux and macOS: always LF.
*.sh text eol=lf

# Byte-exact files: never convert line endings.
*.pdf binary
*.png binary
*.ico binary
*.dll binary

# Linux packaging files are read by Linux tools: always LF.
packaging/linux/** text eol=lf
*.rules text eol=lf
*.desktop text eol=lf
